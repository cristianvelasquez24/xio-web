---
/**
 * Modal de detalle de producto. Hay uno solo en la página: el script `detalle.ts`
 * lo llena con los datos y las fotos de la tarjeta que se abrió.
 */
---

<dialog class="detalle" data-detalle-dialogo aria-labelledby="detalle-nombre">
  <button type="button" class="cerrar" data-cerrar aria-label="Cerrar">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"></path>
    </svg>
  </button>

  <div class="caja">
    <div class="visor">
      <div class="medios">
        <div class="fotos" data-fotos tabindex="-1"></div>
        <button type="button" class="flecha anterior" data-anterior aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
          </svg>
        </button>
        <button type="button" class="flecha siguiente" data-siguiente aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
          </svg>
        </button>
        <span class="etiqueta" data-agotado hidden>Agotado</span>
      </div>
      <div class="miniaturas" data-miniaturas></div>
    </div>

    <div class="info">
      <p class="contexto"><span data-linea></span> · <span data-genero></span></p>
      <h2 id="detalle-nombre" class="nombre" data-nombre></h2>
      <p class="precio" data-precio></p>
      <p class="estado" data-estado hidden>Agotado por ahora</p>
      <div class="bloque-tallas" data-bloque-tallas>
        <p class="rotulo" data-etiqueta-tallas></p>
        <ul class="tallas" data-tallas></ul>
      </div>
    </div>
  </div>
</dialog>

<script>
  import "../scripts/detalle";
</script>

<style>
  /* ---------- Móvil: hoja a pantalla completa ---------- */
  .detalle {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--color-fondo);
    color: var(--color-texto);
  }

  .detalle::backdrop {
    background: color-mix(in srgb, var(--color-fondo) 80%, transparent);
    backdrop-filter: blur(6px);
  }

  /* Bloquea el scroll de la página mientras el modal está abierto. */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .caja {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cerrar {
    position: absolute;
    z-index: 3;
    top: calc(env(safe-area-inset-top, 0px) + var(--espacio-1));
    right: var(--espacio-1);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-fondo) 75%, transparent);
    color: var(--color-texto);
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  .medios {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-superficie);
  }

  .fotos {
    position: absolute;
    inset: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .fotos::-webkit-scrollbar {
    display: none;
  }

  .fotos:focus {
    outline: none;
  }

  /* Las fotos se insertan con JS: se estilan con :global. En el detalle se ve la foto completa. */
  .fotos :global(.slide) {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .fotos :global(picture) {
    position: absolute;
    inset: 0;
  }

  .fotos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .flecha {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-fondo) 75%, transparent);
    color: var(--color-texto);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .flecha:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .anterior {
    left: var(--espacio-1);
  }

  .siguiente {
    right: var(--espacio-1);
  }

  /* Las flechas solo tienen sentido con ratón; en táctil se desliza. */
  @media (hover: hover) {
    .medios.varias .flecha {
      display: grid;
    }
  }

  .etiqueta {
    position: absolute;
    top: var(--espacio-2);
    left: var(--espacio-2);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radio-chip);
    background: var(--color-arena);
    color: var(--color-sobre-acento);
    font-size: var(--texto-pequeno);
    font-weight: 600;
  }

  .miniaturas {
    display: flex;
    gap: var(--espacio-1);
    padding: var(--espacio-1) var(--espacio-2) 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .miniaturas :global(.miniatura) {
    position: relative;
    flex: none;
    width: 3.5rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: calc(var(--radio) / 2);
    background: var(--color-superficie);
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .miniaturas :global(.miniatura[aria-current="true"]) {
    border-color: var(--color-texto);
    opacity: 1;
  }

  .miniaturas :global(.miniatura img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    display: grid;
    align-content: start;
    gap: var(--espacio-2);
    padding: var(--espacio-3) var(--espacio-2);
    padding-bottom: calc(var(--espacio-4) + env(safe-area-inset-bottom, 0px));
  }

  .contexto {
    font-size: var(--texto-pequeno);
    color: var(--color-salvia);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nombre {
    font-size: var(--texto-subtitulo);
    line-height: 1.15;
  }

  .precio {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-subtitulo);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .estado {
    color: var(--color-arena);
    font-weight: 500;
  }

  .bloque-tallas {
    display: grid;
    gap: var(--espacio-1);
    padding-top: var(--espacio-2);
    border-top: 1px solid var(--color-superficie);
  }

  .rotulo {
    font-size: var(--texto-pequeno);
    color: var(--color-texto-suave);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tallas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tallas :global(li) {
    min-width: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-texto-suave);
    border-radius: var(--radio-chip);
    font-size: var(--texto-pequeno);
    font-weight: 500;
    text-align: center;
  }

  /* Entrada suave; sin animación si el usuario la reduce. */
  @media (prefers-reduced-motion: no-preference) {
    .detalle[open] {
      animation: entrar 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .detalle[open]::backdrop {
      animation: aparecer 0.24s ease-out;
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  .fotos {
    cursor: zoom-in;
  }

  /* ---------- Pantalla completa: solo la foto ---------- */
  .detalle.ampliada {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    border-radius: 0;
  }

  .ampliada .caja {
    display: block;
    overflow: hidden;
  }

  .ampliada .info,
  .ampliada .miniaturas,
  .ampliada .etiqueta {
    display: none;
  }

  .ampliada .visor {
    height: 100%;
    padding: 0;
    background: var(--color-fondo);
  }

  .ampliada .medios {
    height: 100%;
    aspect-ratio: auto;
    background: var(--color-fondo);
  }

  .ampliada .fotos {
    cursor: zoom-out;
  }

  /* ---------- Escritorio: ventana centrada en dos columnas ---------- */
  @media (min-width: 48rem) {
    .detalle {
      width: min(64rem, 100% - 4rem);
      height: min(100% - 4rem, 46rem);
      margin: auto;
      border-radius: var(--radio);
    }

    .caja {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      overflow: hidden;
    }

    .visor {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-bottom: var(--espacio-2);
      background: var(--color-superficie);
    }

    .medios {
      flex: 1;
      min-height: 0;
      aspect-ratio: auto;
    }

    .info {
      overflow-y: auto;
      padding: var(--espacio-4) var(--espacio-3);
    }

    .nombre {
      font-size: var(--texto-titulo-medio);
    }
  }
</style>
