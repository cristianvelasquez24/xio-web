---
/**
 * V2 · Barra superior: la marca, la etiqueta "V2", el botón "Closet" (despliega el closet; lo maneja
 * src/scripts/v2/closet.ts y solo se muestra si la página tiene closet) y "V1" (lleva al diseño anterior).
 */
import Logo from "../Logo.astro";
---

<header class="cabecera">
  <a class="inicio" href="/" aria-label="XIO Active Wear, inicio">
    <Logo etiqueta="span" />
    <span class="v2" aria-hidden="true">V2</span>
  </a>
  <div class="acciones">
  <button type="button" class="boton-closet" data-abrir-closet aria-controls="closet" aria-expanded="false" hidden>
    Closet
  </button>
  <a class="volver" href="/v1" aria-label="Ver la versión 1 del diseño">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path d="M20 12H5M10 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    V1
  </a>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.75rem;
    padding: 0.5rem var(--margen);
    background: color-mix(in srgb, var(--color-fondo) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .inicio {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    text-decoration: none;
  }

  .inicio :global(.marca) {
    font-size: 1.375rem;
  }

  .inicio :global(.descriptor) {
    margin-top: 0.1rem;
    font-size: 0.6875rem;
  }

  .v2 {
    padding: 0.15rem 0.4rem;
    border-radius: var(--radio-chip);
    background: var(--v2-tinta);
    color: var(--v2-sobre-tinta);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
  }

  .boton-closet {
    min-height: 2.25rem;
    padding: 0 1rem;
    border: 1px solid color-mix(in srgb, var(--v2-tinta) 25%, transparent);
    border-radius: var(--radio-chip);
    background: transparent;
    color: var(--v2-tinta);
    font: 600 var(--texto-pequeno) var(--fuente-titulos);
    cursor: pointer;
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease,
      transform var(--t-press) var(--ease-out);
  }

  .boton-closet:active {
    transform: scale(0.96);
  }

  .boton-closet[aria-expanded="true"] {
    border-color: var(--v2-tinta);
    background: var(--v2-tinta);
    color: var(--v2-sobre-tinta);
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: var(--color-texto-suave);
    font-size: var(--texto-pequeno);
    font-weight: 600;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .volver:hover {
      color: var(--color-texto);
    }
  }
</style>
