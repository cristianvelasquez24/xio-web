---
import { productos } from "../lib/productos";
import Detalle from "./Detalle.astro";
import Filtros from "./Filtros.astro";
import TarjetaProducto from "./TarjetaProducto.astro";
---

<section id="catalogo" class="catalogo" aria-labelledby="catalogo-titulo">
  <div class="cabecera" data-entra>
    <h2 id="catalogo-titulo">Colección</h2>
    <p class="contador" data-contador aria-live="polite">{productos.length} prendas</p>
  </div>

  <div data-entra>
    <Filtros />
  </div>

  <div class="grid">
    {productos.map((producto) => <TarjetaProducto producto={producto} />)}
  </div>

  <div class="vacio" data-vacio hidden>
    <p>Aún no hay prendas en esta combinación.</p>
    <button type="button" class="limpiar" data-limpiar>Ver todo</button>
  </div>
</section>

<Detalle />

<script>
  import "../scripts/filtros";
  import "../scripts/galeria";
  import "../scripts/abrir-producto";
</script>

<style>
  .catalogo {
    display: grid;
    gap: var(--espacio-3);
    padding: var(--espacio-seccion) var(--margen);
    padding-bottom: calc(var(--espacio-4) + env(safe-area-inset-bottom, 0px));
    scroll-margin-top: var(--espacio-2);
  }

  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--espacio-1) var(--espacio-2);
  }

  h2 {
    font-size: var(--texto-display);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: var(--tracking-display);
  }

  .contador {
    font-size: var(--texto-base);
    color: var(--color-texto-suave);
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espacio-3) var(--espacio-2);
  }

  .vacio {
    display: grid;
    justify-items: start;
    gap: var(--espacio-2);
    padding: var(--espacio-3);
    border-radius: var(--radio);
    background: var(--color-superficie);
    color: var(--color-texto-suave);
  }

  .limpiar {
    min-height: 2.75rem;
    padding: 0 var(--espacio-2);
    border: 0;
    border-radius: var(--radio-chip);
    background: var(--color-salvia);
    color: var(--color-sobre-acento);
    font-size: var(--texto-pequeno);
    font-weight: 600;
    cursor: pointer;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espacio-4) var(--espacio-3);
    }
  }

  @media (min-width: 72rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* El título entra deslizándose con el scroll. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      h2 {
        animation-name: titulo-entra;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes titulo-entra {
    from {
      translate: -30% 0;
    }
    to {
      translate: 0 0;
    }
  }
</style>
