---
import { FILTROS } from "../scripts/filtros-estado";
---

<div class="filtros">
  {
    FILTROS.map((filtro) => (
      <div class="grupo" role="group" aria-label={filtro.etiqueta}>
        {filtro.opciones.map((opcion, i) => (
          <button
            type="button"
            class="chip"
            data-filtro={filtro.clave}
            data-valor={opcion.valor}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {opcion.texto}
          </button>
        ))}
      </div>
    ))
  }
</div>

<style>
  .filtros {
    display: grid;
    gap: var(--espacio-1);
  }

  /* Sin JS los filtros no funcionarían: se ocultan y se ve todo el catálogo. */
  :global(.no-js) .filtros {
    display: none;
  }

  /* Los chips bajan de línea si no caben: nunca se salen del margen. */
  .grupo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1);
    min-width: 0;
  }

  .chip {
    flex: none;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-texto-suave);
    border-radius: var(--radio-chip);
    background: transparent;
    font-size: var(--texto-pequeno);
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    border-color: var(--color-texto);
  }

  .chip[aria-pressed="true"] {
    background: var(--color-salvia);
    border-color: var(--color-salvia);
    color: var(--color-sobre-acento);
  }

  @media (min-width: 48rem) {
    .filtros {
      display: flex;
      flex-wrap: wrap;
      gap: var(--espacio-3);
    }
  }
</style>
