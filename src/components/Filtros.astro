---
import { FILTROS } from "../scripts/filtros-estado";
---

<div class="filtros">
  {
    FILTROS.map((filtro) => (
      <div class="grupo" role="group" aria-label={filtro.etiqueta}>
        {filtro.opciones.map((opcion, i) => (
          <button
            type="button"
            class="chip"
            data-filtro={filtro.clave}
            data-valor={opcion.valor}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {opcion.texto}
          </button>
        ))}
      </div>
    ))
  }
</div>

<style>
  .filtros {
    display: grid;
    gap: var(--espacio-1);
  }

  /* Sin JS los filtros no funcionarían: se ocultan y se ve todo el catálogo. */
  :global(.no-js) .filtros {
    display: none;
  }

  /* Los chips bajan de línea si no caben: nunca se salen del margen. */
  .grupo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1);
    min-width: 0;
  }

  .chip {
    flex: none;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 0;
    border-radius: var(--radio-chip);
    background: var(--color-superficie);
    font-size: var(--texto-base);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease,
      transform var(--t-press) var(--ease-out);
  }

  .chip:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      background: color-mix(in srgb, var(--color-superficie), var(--color-texto) 14%);
    }
  }

  .chip[aria-pressed="true"] {
    background: var(--color-salvia);
    color: var(--color-sobre-acento);
  }

  @media (min-width: 48rem) {
    .filtros {
      display: flex;
      flex-wrap: wrap;
      gap: var(--espacio-3);
    }
  }
</style>
