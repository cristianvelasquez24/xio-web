---
/**
 * Logotipo tipográfico. Para cambiarlo por una imagen, reemplazar solo este componente.
 * - "normal": marca con el descriptor debajo, en pequeño.
 * - "monumento": marca al tamaño display con el descriptor en línea, para la banda de la portada.
 */
interface Props {
  tamano?: "monumento" | "normal";
  etiqueta?: "h1" | "p" | "span";
  /** Copias decorativas (la banda de la portada repite la marca). */
  decorativo?: boolean;
}

const { tamano = "normal", etiqueta: Etiqueta = "p", decorativo = false } = Astro.props;
---

<Etiqueta class:list={["logo", tamano]} aria-hidden={decorativo ? "true" : undefined}>
  <span class="marca">Active Wear</span>
  <span class="descriptor">Xio</span>
</Etiqueta>

<style>
  .logo {
    display: inline-flex;
    margin: 0;
    font-family: var(--fuente-titulos);
    line-height: 1;
  }

  .marca {
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }

  .descriptor {
    font-family: var(--fuente-base);
    font-weight: 500;
    color: var(--color-salvia);
  }

  .normal {
    flex-direction: column;
    align-items: flex-start;
  }

  .normal .marca {
    font-size: var(--texto-titulo);
  }

  .normal .descriptor {
    margin-top: 0.25rem;
    font-size: var(--texto-pequeno);
  }

  /* La marca enorme y el descriptor al pie de sus letras, en la misma línea. */
  .monumento {
    flex-direction: row;
    align-items: baseline;
    gap: 0.35em;
    line-height: 0.82;
    white-space: nowrap;
  }

  /* Quien lo usa puede fijar el tamaño con `--tamano-marca` (la portada lo ajusta al ancho). */
  .monumento .marca {
    font-size: var(--tamano-marca, var(--texto-display));
    line-height: 0.82;
  }

  .monumento .descriptor {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-titulo);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
</style>
