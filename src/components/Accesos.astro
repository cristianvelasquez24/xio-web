---
import { Picture } from "astro:assets";
import { NOMBRE_LINEA, productos, resumen, type Linea } from "../lib/productos";

interface Acceso {
  linea: Linea;
  texto: string;
}

// El primero es el protagonista (el panel más ancho). Beauty no tiene acceso: solo filtro.
const accesos: Acceso[] = [
  { linea: "sport", texto: "Para moverte" },
  { linea: "casual", texto: "Para el resto del día" },
  { linea: "bolsos", texto: "Para llevarlo todo" },
];

/** Máximo de fotos candidatas por acceso (cada una suma un poco de HTML, no de descarga). */
const MAX_CANDIDATAS = 10;

// Candidatas: la foto principal de cada producto disponible de la línea.
// Si todos están agotados, se usa el primero para no dejar el panel vacío.
const candidatasDe = (linea: Linea) => {
  const disponibles = productos.filter((p) => p.linea === linea && !p.agotado);
  const lista = disponibles.length > 0 ? disponibles : productos.filter((p) => p.linea === linea).slice(0, 1);
  return lista.slice(0, MAX_CANDIDATAS).map((p) => p.fotos[0]);
};
---

<section class="accesos" aria-labelledby="accesos-titulo">
  <h2 id="accesos-titulo" class="titulo" data-entra>Elige tu línea</h2>

  <nav class="banda" aria-labelledby="accesos-titulo">
    {
      accesos.map(({ linea, texto }, i) => (
        <a class:list={["acceso", linea]} href={`?linea=${linea}#catalogo`} data-acceso-linea={linea} data-entra style={`--crece: ${[5, 3, 2][i] ?? 2}`}>
          {candidatasDe(linea).map((foto, j) => (
            <Picture
              src={foto}
              alt=""
              formats={["avif", "webp"]}
              widths={[400, 800, 1200]}
              sizes={i === 0 ? "(min-width: 48rem) 50vw, 100vw" : "(min-width: 48rem) 30vw, 60vw"}
              class="foto"
              pictureAttributes={{ class: "marco", "data-candidata": "", hidden: j !== 0 }}
            />
          ))}
          <span class="texto">
            <span class="nombre">{NOMBRE_LINEA[linea]}</span>
            <span class="detalle">
              {texto} · {resumen.porLinea[linea]}
            </span>
          </span>
        </a>
      ))
    }
  </nav>

  <p class="nota" data-entra>Beauty, con perfumes y cremas, está en la colección.</p>
</section>

<!--
  Foto al azar en cada visita. Corre en línea, justo después del HTML de los accesos y antes
  de que se vean: las fotos son de carga diferida y las ocultas nunca se descargan.
  Sin JavaScript se ve la primera candidata.
-->
<script is:inline>
  for (const acceso of document.querySelectorAll(".accesos [data-acceso-linea]")) {
    const fotos = acceso.querySelectorAll("[data-candidata]");
    const elegida = Math.floor(Math.random() * fotos.length);
    fotos.forEach((foto, i) => (foto.hidden = i !== elegida));
  }
</script>

<style>
  .accesos {
    display: grid;
    gap: var(--espacio-3);
    padding-top: var(--espacio-seccion);
  }

  .titulo,
  .nota {
    padding-inline: var(--margen);
  }

  .titulo {
    font-size: var(--texto-titulo);
  }

  /* Móvil: Sport arriba a todo el ancho; Casual y Bolsos debajo, en anchos desiguales. */
  .banda {
    display: grid;
    grid-template-columns: 64fr 36fr;
    grid-template-rows: 1.2fr 1fr;
    height: 84svh;
    min-height: 32rem;
  }

  .acceso {
    position: relative;
    display: grid;
    overflow: clip;
    background: var(--color-superficie);
    color: var(--color-texto);
    text-decoration: none;
    isolation: isolate;
  }

  .sport {
    grid-column: 1 / -1;
  }

  .marco {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease-soft);
  }

  /* El nombre va arriba a la izquierda, sobre una sombra neutra que solo cubre esa esquina. */
  .texto {
    align-self: start;
    justify-self: start;
    display: grid;
    gap: 0.25rem;
    margin: var(--espacio-2);
    padding: 0.75rem 1rem;
    border-radius: var(--radio);
    background: rgb(0 0 0 / 0.42);
  }

  .nombre {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-titulo);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .detalle {
    font-size: var(--texto-pequeno);
  }

  .nota {
    color: var(--color-texto-suave);
  }

  /* Escritorio: una sola banda de borde a borde; al pasar el cursor, el panel se abre. */
  @media (min-width: 48rem) {
    .titulo {
      padding-left: calc(var(--margen) + (100% - 2 * var(--margen)) / 6);
    }

    .banda {
      display: flex;
      height: 68svh;
      min-height: 28rem;
    }

    .acceso {
      flex: var(--crece) 1 0;
      min-width: 0;
      /* Se suman las transiciones de entrada (global.css) para no pisarlas. */
      transition:
        flex-grow 500ms var(--ease-in-out),
        opacity 700ms var(--ease-out) var(--retraso, 0ms),
        transform 900ms var(--ease-expo) var(--retraso, 0ms);
    }

    .nombre {
      font-size: var(--texto-titulo);
    }
  }

  @media (min-width: 48rem) and (hover: hover) and (pointer: fine) {
    .banda:hover .acceso:hover {
      flex-grow: 6;
    }

    .acceso:hover .foto {
      scale: 1.05;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acceso,
    .foto {
      transition: none;
    }
  }

  /* Movimiento ligado al scroll (pensado para el celular, donde no hay cursor):
     al bajar, cada foto se aleja un poco y el nombre entra desde la izquierda. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .acceso {
        view-timeline: --panel block;
      }

      .marco {
        animation-name: alejar;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --panel;
        animation-range: entry 0% cover 60%;
      }

      .texto {
        animation-name: deslizar;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --panel;
        animation-range: entry 20% entry 100%;
      }
    }
  }

  @keyframes alejar {
    from {
      transform: scale(1.25) translateY(6%);
    }
    to {
      transform: none;
    }
  }

  @keyframes deslizar {
    from {
      opacity: 0;
      translate: -2.5rem 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Al tocar un panel en el celular, la foto responde. */
  .acceso:active .foto {
    scale: 1.04;
  }
</style>
