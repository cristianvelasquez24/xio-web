---
import { Picture } from "astro:assets";
import { config } from "../config";
import { formatearPrecio } from "../lib/precio";
import { altProducto, NOMBRE_GENERO, NOMBRE_LINEA, type Producto } from "../lib/productos";

interface Props {
  producto: Producto;
}

const { producto: p } = Astro.props;
// Las agotadas no muestran precio.
const precio = config.mostrarPrecio && !p.agotado && p.precio !== null ? formatearPrecio(p.precio) : null;
// En Beauty el campo `tallas` es la presentación (ej. "236 ml").
const etiquetaTallas = p.linea === "beauty" ? "Presentación" : p.tallas.length === 1 ? "Talla" : "Tallas";
const tallas = p.tallas.length > 0 ? `${etiquetaTallas} ${p.tallas.join(" · ")}` : null;
const variasFotos = p.fotos.length > 1;
---

<article
  class:list={["tarjeta", { agotado: p.agotado }]}
  id={`producto-${p.id}`}
  data-producto
  data-id={p.id}
  data-genero={p.genero}
  data-linea={p.linea}
  data-detalle={JSON.stringify({
    nombre: p.nombre,
    linea: NOMBRE_LINEA[p.linea],
    genero: NOMBRE_GENERO[p.genero],
    precio,
    etiquetaTallas: p.tallas.length > 0 ? etiquetaTallas : null,
    tallas: p.tallas,
    agotado: p.agotado,
  })}
>
  <div class="foto-marco">
    <div class="galeria" data-galeria tabindex={variasFotos ? 0 : undefined} aria-label={variasFotos ? `Fotos de ${p.nombre}` : undefined}>
      {
        p.fotos.map((foto, i) => (
          <div class="slide">
            <Picture
              src={foto}
              alt={i === 0 ? altProducto(p) : `${altProducto(p)}, foto ${i + 1}`}
              formats={["avif", "webp"]}
              widths={[400, 800, 1200]}
              sizes="(min-width: 72rem) 25vw, (min-width: 48rem) 33vw, 50vw"
              class="foto"
              pictureAttributes={{ class: "foto-picture" }}
            />
          </div>
        ))
      }
    </div>
    {
      variasFotos && (
        <div class="puntos">
          {p.fotos.map((_, i) => (
            <button type="button" class="punto" data-punto={i} aria-label={`Ver foto ${i + 1}`} aria-current={i === 0 ? "true" : undefined} />
          ))}
        </div>
      )
    }
    {p.agotado && <span class="etiqueta">Agotado</span>}
  </div>
  <div class="info">
    <h3 class="nombre">
      <button type="button" class="abrir" data-abrir-detalle aria-haspopup="dialog">{p.nombre}</button>
    </h3>
    <p class="linea">{NOMBRE_LINEA[p.linea]}</p>
    {tallas && <p class="tallas">{tallas}</p>}
    {precio && <p class="precio">{precio}</p>}
  </div>
</article>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-1);
  }

  .foto-marco {
    position: relative;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--color-superficie);
    aspect-ratio: 4 / 5;
  }

  /* Galería: deslizar con el dedo en móvil; los puntos sirven también con ratón. */
  .galeria {
    position: absolute;
    inset: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .galeria::-webkit-scrollbar {
    display: none;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .foto-picture {
    position: absolute;
    inset: 0;
  }

  .puntos {
    position: absolute;
    bottom: var(--espacio-1);
    left: 50%;
    translate: -50% 0;
    display: flex;
    gap: 0.125rem;
    padding: 0.125rem 0.25rem;
    border-radius: var(--radio-chip);
    background: color-mix(in srgb, var(--color-fondo) 55%, transparent);
  }

  .punto {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .punto::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-texto-suave);
    transition: background-color 0.2s ease, scale 0.2s ease;
  }

  .punto[aria-current="true"]::before {
    background: var(--color-texto);
    scale: 1.3;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .agotado .foto {
    opacity: var(--opacidad-agotado);
    filter: grayscale(0.6);
  }

  .etiqueta {
    position: absolute;
    top: var(--espacio-1);
    left: var(--espacio-1);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radio-chip);
    background: var(--color-arena);
    color: var(--color-sobre-acento);
    font-size: var(--texto-pequeno);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .info {
    display: grid;
    gap: 0.125rem;
    padding-inline: 0.125rem;
  }

  .nombre {
    font-size: var(--texto-base);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  /* El nombre abre el detalle (igual que tocar la foto); se ve como texto normal. */
  .abrir {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
  }

  .abrir:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .galeria {
    cursor: zoom-in;
  }

  .linea {
    font-size: var(--texto-pequeno);
    color: var(--color-texto-suave);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tallas {
    font-size: var(--texto-pequeno);
    color: var(--color-texto-suave);
  }

  .precio {
    font-size: var(--texto-pequeno);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
</style>
