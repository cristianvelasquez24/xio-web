---
/**
 * Vitrina circular (inspirada en "Circular Testimonials" de 21st.dev): la prenda activa al frente
 * y las vecinas detrás, giradas en 3D. El nombre entra palabra por palabra, desenfocado.
 * Flechas, deslizar con el dedo y teclado; avanza sola hasta que la persona la toca.
 * Se eligen al azar en cada visita entre las disponibles. Tocar la foto activa abre su detalle.
 */
import { Picture } from "astro:assets";
import { config } from "../config";
import { formatearPrecio } from "../lib/precio";
import { altProducto, NOMBRE_GENERO, NOMBRE_LINEA, productos } from "../lib/productos";

/** Candidatas en el HTML; el navegador se queda con `EN_VITRINA` al azar (las demás nunca se descargan). */
const MAX_CANDIDATAS = 14;
const EN_VITRINA = 6;

// La destacada de la portada no se repite aquí.
const destacadaPortada = productos.find((p) => p.destacado && !p.agotado);
const candidatas = productos.filter((p) => !p.agotado && p !== destacadaPortada).slice(0, MAX_CANDIDATAS);

const detalle = (p: (typeof candidatas)[number]) => {
  const tallas = p.tallas.length === 0 ? null : `${p.linea === "beauty" ? "Presentación" : p.tallas.length === 1 ? "Talla" : "Tallas"} ${p.tallas.join(" · ")}`;
  const precio = config.mostrarPrecio && p.precio !== null ? formatearPrecio(p.precio) : null;
  return { tallas, precio };
};
---

<section class="vitrina" aria-labelledby="vitrina-titulo" aria-roledescription="carrusel" data-vitrina data-en-vitrina={EN_VITRINA}>
  <h2 id="vitrina-titulo" class="titulo" data-entra>De cerca.</h2>

  <div class="escena">
    <div class="pila" data-pila>
      {
        candidatas.map((p, i) => (
          <a
            class="foto-vitrina"
            href={`#producto-${p.id}`}
            data-abrir-producto={p.id}
            data-diapositiva
            data-pos={i === 0 ? "activa" : i === 1 ? "siguiente" : i === EN_VITRINA - 1 ? "anterior" : "oculta"}
            hidden={i >= EN_VITRINA}
          >
            <Picture
              src={p.fotos[0]}
              alt={altProducto(p)}
              formats={["avif", "webp"]}
              widths={[400, 800]}
              sizes="(min-width: 60rem) 30vw, 62vw"
              class="foto"
              pictureAttributes={{ class: "marco" }}
            />
          </a>
        ))
      }
    </div>

    <div class="texto" aria-live="off" data-textos>
      {
        candidatas.map((p, i) => {
          const { tallas, precio } = detalle(p);
          return (
            <div class="ficha" data-ficha hidden={i !== 0}>
              <p class="linea">
                {NOMBRE_LINEA[p.linea]} · {NOMBRE_GENERO[p.genero]}
              </p>
              <h3 class="nombre">
                {p.nombre.split(" ").map((palabra, j) => (
                  <>
                    <span class="palabra" style={`--i: ${j}`}>{palabra}</span>{" "}
                  </>
                ))}
              </h3>
              {(tallas || precio) && (
                <p class="datos">
                  {tallas && <span>{tallas}</span>}
                  {precio && <span class="precio">{precio}</span>}
                </p>
              )}
            </div>
          );
        })
      }

      <div class="controles" data-controles hidden>
        <button type="button" class="flecha" data-anterior aria-label="Prenda anterior">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
          </svg>
        </button>
        <button type="button" class="flecha" data-siguiente aria-label="Prenda siguiente">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
          </svg>
        </button>
        <p class="cuenta" data-cuenta aria-hidden="true"></p>
      </div>
    </div>
  </div>
</section>

<!-- Elección al azar antes de que se vea: las fotos son diferidas y las descartadas se quitan del HTML. -->
<script is:inline>
  {
    const vitrina = document.querySelector("[data-vitrina]");
    const n = Number(vitrina.dataset.enVitrina);
    const fotos = [...vitrina.querySelectorAll("[data-diapositiva]")];
    const fichas = [...vitrina.querySelectorAll("[data-ficha]")];
    const orden = fotos.map((_, i) => i).sort(() => Math.random() - 0.5);
    const elegidas = new Set(orden.slice(0, n));
    fotos.forEach((f, i) => {
      if (!elegidas.has(i)) {
        f.remove();
        fichas[i].remove();
      }
    });
    const pila = vitrina.querySelector("[data-pila]");
    const textos = vitrina.querySelector("[data-textos]");
    const controles = vitrina.querySelector("[data-controles]");
    orden.slice(0, n).forEach((i) => {
      pila.append(fotos[i]);
      textos.insertBefore(fichas[i], controles);
    });
  }
</script>

<script>
  import "../scripts/vitrina";
</script>

<style>
  .vitrina {
    display: grid;
    gap: var(--espacio-3);
    padding: var(--espacio-seccion) var(--margen) 0;
    overflow: clip;
  }

  .titulo {
    font-size: var(--texto-display);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: var(--tracking-display);
  }

  .escena {
    display: grid;
    gap: var(--espacio-3);
  }

  /* La pila: la foto activa al centro, las vecinas asoman detrás a cada lado. */
  .pila {
    --ancho: 58vw;
    --hueco: calc(var(--ancho) * 0.42);
    --sube: calc(var(--hueco) * 0.35);
    position: relative;
    width: var(--ancho);
    aspect-ratio: 4 / 5;
    margin: var(--sube) auto 0;
    perspective: 1000px;
    touch-action: pan-y;
  }

  .foto-vitrina {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: var(--radio);
    overflow: clip;
    background: var(--color-superficie);
    box-shadow: 0 1.5rem 3rem -1.5rem var(--color-sobre-acento);
    transition:
      transform 800ms cubic-bezier(0.4, 2, 0.3, 1),
      opacity 800ms var(--ease-out);
  }

  .foto-vitrina[data-pos="activa"] {
    z-index: 3;
    transform: none;
  }

  .foto-vitrina[data-pos="anterior"] {
    z-index: 2;
    transform: translateX(calc(var(--hueco) * -1)) translateY(calc(var(--sube) * -1)) scale(0.85) rotateY(15deg);
  }

  .foto-vitrina[data-pos="siguiente"] {
    z-index: 2;
    transform: translateX(var(--hueco)) translateY(calc(var(--sube) * -1)) scale(0.85) rotateY(-15deg);
  }

  .foto-vitrina[data-pos="oculta"] {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.7);
  }

  /* Las vecinas quedan atenuadas: el ojo va a la del frente. */
  .foto-vitrina:not([data-pos="activa"]) .foto {
    filter: brightness(0.7);
  }

  .marco {
    height: 100%;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 800ms var(--ease-out);
  }

  .texto {
    display: grid;
    align-content: center;
    gap: var(--espacio-3);
  }

  .ficha {
    display: grid;
    gap: var(--espacio-1);
    min-height: 9rem;
  }

  .linea {
    color: var(--color-texto-suave);
    font-size: var(--texto-pequeno);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nombre {
    font-size: var(--texto-titulo);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .palabra {
    display: inline-block;
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--color-texto-suave);
  }

  .precio {
    color: var(--color-texto);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .controles {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .flecha {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-superficie);
    color: var(--color-texto);
    cursor: pointer;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }

  .flecha:active {
    transform: scale(0.92);
  }

  @media (hover: hover) and (pointer: fine) {
    .flecha:hover {
      background: var(--color-salvia);
      color: var(--color-sobre-acento);
    }
  }

  .cuenta {
    margin-left: auto;
    color: var(--color-texto-suave);
    font-size: var(--texto-pequeno);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 60rem) {
    .escena {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: var(--espacio-4);
    }

    .pila {
      --ancho: min(26vw, 52svh * 4 / 5);
    }

    .nombre {
      font-size: clamp(2.25rem, 4vw, 3.75rem);
    }
  }

  /* El nombre entra palabra por palabra, saliendo del desenfoque (cada vez que cambia la prenda). */
  @media (prefers-reduced-motion: no-preference) {
    .ficha.entra .linea,
    .ficha.entra .datos {
      animation: subir 400ms var(--ease-out) both;
    }

    .ficha.entra .datos {
      animation-delay: 160ms;
    }

    .ficha.entra .palabra {
      animation: enfocar 420ms var(--ease-in-out) both;
      animation-delay: calc(var(--i) * 60ms + 60ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foto-vitrina,
    .foto {
      transition: none;
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @keyframes enfocar {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.3em);
    }
  }
</style>
