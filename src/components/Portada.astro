---
import { Picture } from "astro:assets";
import foto from "../assets/portada.jpg";
import { config } from "../config";
import Logo from "./Logo.astro";
---

<header class="portada">
  <Picture
    src={foto}
    alt={config.portada.alt}
    formats={["avif", "webp"]}
    widths={[400, 800, 1200, 1600]}
    sizes="(min-width: 60rem) 50vw, 100vw"
    loading="eager"
    fetchpriority="high"
    class="foto"
    pictureAttributes={{ class: "marco" }}
  />
  <div class="texto">
    <Logo tamano="grande" etiqueta="h1" />
    {config.lemaPortada && <p class="lema">{config.lemaPortada}</p>}
    <a class="bajar" href="#catalogo">Ver colección</a>
  </div>
</header>

<style>
  .portada {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
  }

  .marco,
  .texto {
    grid-area: 1 / 1;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .texto {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--espacio-3);
    padding: var(--espacio-3) var(--espacio-2);
    padding-bottom: calc(var(--espacio-4) + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, var(--color-fondo) 8%, transparent 65%);
  }

  .lema {
    max-width: 28ch;
    color: var(--color-texto-suave);
  }

  .bajar {
    font-size: var(--texto-pequeno);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--color-salvia);
  }

  /* Escritorio: marca a la izquierda, foto vertical a la derecha. */
  @media (min-width: 60rem) {
    .portada {
      grid-template-columns: 1fr 1fr;
    }

    .marco {
      grid-area: 1 / 2;
    }

    .texto {
      grid-area: 1 / 1;
      justify-content: center;
      padding: var(--espacio-4);
      background: none;
    }
  }
</style>
