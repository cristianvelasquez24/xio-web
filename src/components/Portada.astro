---
/**
 * Portada en mosaico: la marca enorme, fija, en una banda; debajo las líneas,
 * la foto de portada con la frase que dice qué es XIO, una prenda destacada, las marcas
 * y una columna de bloques de color con las cifras del catálogo y el botón principal.
 */
import { Picture } from "astro:assets";
import foto from "../assets/portada.png";
import { config } from "../config";
import { altProducto, NOMBRE_LINEA, productos, resumen, type Linea } from "../lib/productos";
import Logo from "./Logo.astro";

const lineas: Linea[] = ["sport", "casual", "bolsos", "beauty"];
const destacada = productos.find((p) => p.destacado && !p.agotado) ?? productos.find((p) => !p.agotado) ?? productos[0];

const cifras = [
  { valor: resumen.total, texto: "prendas" },
  { valor: resumen.mujer, texto: "para mujer" },
  { valor: resumen.hombre, texto: "para hombre" },
  { valor: resumen.unaTalla, texto: "en una sola talla" },
];

/** Fotos candidatas por bloque; el navegador elige una al azar y las demás nunca se descargan. */
const MAX_CANDIDATAS = 6;
const disponibles = productos.filter((p) => !p.agotado && p !== destacada);

// Fondo del bloque de la frase (solo escritorio): una prenda de Sport.
const fondosFrase = disponibles.filter((p) => p.linea === "sport").slice(0, MAX_CANDIDATAS);

// Cada marca muestra una de sus prendas: se reconocen por la primera palabra de la marca
// en el nombre o el id ("Victoria's Secret" → "victoria").
const marcas = config.portada.marcas.map((nombre) => {
  const clave = nombre.toLowerCase().split(/[\s']/)[0];
  const prendas = disponibles.filter((p) => `${p.nombre} ${p.id}`.toLowerCase().includes(clave)).slice(0, MAX_CANDIDATAS);
  return { nombre, prendas };
});
---

<header class="portada">
  <div class="banda">
    <span class="mascara"><Logo tamano="monumento" etiqueta="h1" /></span>
    <a class="ir-v2" href="/v2" aria-label="Ver la versión 2 del diseño">V2</a>
  </div>

  <nav class="enlaces" aria-label="Ir a una línea">
    {
      lineas.map((linea, i) => (
        <a class="enlace" href={`?linea=${linea}#catalogo`} data-acceso-linea={linea} data-carga style={`--d: ${120 + i * 60}ms`}>
          <span>{NOMBRE_LINEA[linea]}</span>
          <span class="cuenta">{resumen.porLinea[linea]}</span>
        </a>
      ))
    }
  </nav>

  <div class="principal" data-carga-foto>
    <Picture
      src={foto}
      alt={config.portada.alt}
      formats={["avif", "webp"]}
      widths={[400, 800, 1200, 1600]}
      sizes="(min-width: 60rem) 66vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="foto"
      pictureAttributes={{ class: "foto-marco" }}
    />
  </div>

  <div class="frase" data-carga style="--d: 420ms">
    <div class="frase-fondo" data-azar aria-hidden="true">
      {
        fondosFrase.map((p, j) => (
          <Picture
            src={p.fotos[0]}
            alt=""
            formats={["avif", "webp"]}
            widths={[400, 800]}
            sizes="(min-width: 60rem) 33vw, 1px"
            class="foto"
            pictureAttributes={{ class: "foto-marco", "data-candidata": "", hidden: j !== 0 }}
          />
        ))
      }
    </div>
    <p>{config.portada.frase}</p>
    {config.lemaPortada && <p class="lema">{config.lemaPortada}</p>}
  </div>

  <a class="retrato" href={`#producto-${destacada.id}`} data-abrir-producto={destacada.id} data-carga style="--d: 300ms">
    <Picture
      src={destacada.fotos[0]}
      alt={altProducto(destacada)}
      formats={["avif", "webp"]}
      widths={[400, 800]}
      sizes="(min-width: 60rem) 16vw, 1px"
      class="foto"
      pictureAttributes={{ class: "foto-marco" }}
    />
    <span class="pie">{destacada.nombre}</span>
  </a>

  <div class="marcas" data-carga style="--d: 360ms">
    <p class="rotulo">Marcas</p>
    <ul>
      {
        marcas.map(({ nombre, prendas }) => (
          <li>
            {prendas.length > 0 ? (
              <a class="marca" href={`#producto-${prendas[0].id}`} data-abrir-producto={prendas[0].id} data-azar>
                <span class="miniatura">
                  {prendas.map((p, j) => (
                    <Picture
                      src={p.fotos[0]}
                      alt={altProducto(p)}
                      formats={["avif", "webp"]}
                      widths={[200, 400]}
                      sizes="(min-width: 60rem) 3rem, 28vw"
                      class="foto"
                      pictureAttributes={{ class: "foto-marco", "data-candidata": "", "data-id": p.id, hidden: j !== 0 }}
                    />
                  ))}
                </span>
                <span class="nombre-marca">{nombre}</span>
              </a>
            ) : (
              <span class="marca">
                <span class="miniatura" />
                <span class="nombre-marca">{nombre}</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="cifras">
    {
      cifras.map((c, i) => (
        <li class="cifra" data-carga style={`--d: ${360 + i * 70}ms`}>
          <span class="valor">{c.valor}</span>
          <span>{c.texto}</span>
        </li>
      ))
    }
  </ul>

  <a class="accion" href="#catalogo" data-carga style="--d: 640ms">
    <span>Ver la colección</span>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path d="M12 4v16M5 13l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
    </svg>
  </a>
</header>

<!--
  Foto al azar en cada visita para el fondo de la frase y cada marca. Corre en línea, antes de que
  se vean: las fotos son diferidas y las ocultas nunca se descargan. El enlace de cada marca
  apunta a la prenda elegida. Sin JavaScript se ve la primera candidata.
-->
<script is:inline>
  for (const bloque of document.querySelectorAll(".portada [data-azar]")) {
    const fotos = bloque.querySelectorAll("[data-candidata]");
    const elegida = Math.floor(Math.random() * fotos.length);
    fotos.forEach((foto, i) => (foto.hidden = i !== elegida));
    const id = fotos[elegida]?.dataset.id;
    if (id && bloque.dataset.abrirProducto) {
      bloque.dataset.abrirProducto = id;
      bloque.href = `#producto-${id}`;
    }
  }
</script>

<style>
  /* ---------- Móvil: los bloques se apilan ---------- */
  .portada {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--separacion-mosaico);
    padding: var(--margen);
    padding-top: calc(var(--margen) + env(safe-area-inset-top, 0px));
  }

  .banda,
  .enlace,
  .principal,
  .frase,
  .retrato,
  .marcas,
  .cifra,
  .accion {
    border-radius: var(--radio);
  }

  /* Banda con la marca, fija. El tamaño se ajusta al ancho para que quepa en una línea
     en el celular sin cortarse. */
  .banda {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0.75rem var(--espacio-2) 1rem;
    background: var(--color-superficie);
  }

  /* Acceso a la propuesta de diseño V2 (/v2): pequeño, en la esquina de la banda. */
  .banda {
    position: relative;
  }

  /* Área táctil de 44px; la píldora visible es más pequeña (::before). */
  .ir-v2 {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0.25rem;
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-salvia);
    font-family: var(--fuente-titulos);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }

  .ir-v2::before {
    content: "";
    position: absolute;
    inset: 0.8rem 0.35rem;
    z-index: -1;
    border: 1px solid var(--color-salvia);
    border-radius: var(--radio-chip);
    transition: background-color var(--t-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ir-v2:hover {
      color: var(--color-sobre-acento);
    }

    .ir-v2:hover::before {
      background: var(--color-salvia);
    }
  }

  .mascara {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
  }

  /* "Active Wear" mide unas 6 veces su tamaño de letra: se reparte el ancho libre de la banda. */
  .banda {
    --tamano-marca: min((100vw - 4.5rem) / 6.2, 11rem);
  }

  /* El descriptor va al pie de la marca, sin restarle ancho en pantallas angostas. */
  .banda :global(.logo) {
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }

  /* Líneas */
  .enlaces {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--separacion-mosaico);
  }

  .enlace {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    min-height: 4rem;
    padding: var(--espacio-2);
    background: var(--color-superficie);
    font-family: var(--fuente-titulos);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }

  .enlace:active {
    transform: scale(0.97);
  }

  .cuenta {
    color: var(--color-texto-suave);
    font-family: var(--fuente-base);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) and (pointer: fine) {
    .enlace:hover {
      background: var(--color-texto);
      color: var(--color-sobre-acento);
    }

    .enlace:hover .cuenta {
      color: inherit;
    }
  }

  /* Foto principal: de cuerpo entero (4:5). En el celular se ve completa, sin recortes. */
  .principal {
    grid-column: 1 / -1;
    overflow: clip;
    aspect-ratio: 4 / 5;
    background: var(--color-superficie);
  }

  /* Tablet: misma proporción, pero sin pasar de una pantalla de alto. */
  @media (min-width: 30rem) and (max-width: 59.99rem) {
    .principal,
    .frase {
      justify-self: center;
      width: min(100%, 72svh * 4 / 5);
    }
  }

  .foto-marco {
    height: 100%;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Móvil: la frase va sobre el pie de la foto principal, sobre una sombra del color de fondo
     que la hace legible. Así la foto y lo que dice XIO se ven juntos en la primera pantalla. */
  .frase {
    grid-column: 1 / -1;
    align-self: end;
    z-index: 1;
    display: grid;
    gap: var(--espacio-1);
    padding: var(--espacio-4) var(--espacio-2) var(--espacio-2);
    border-radius: 0 0 var(--radio) var(--radio);
    background: linear-gradient(to top, var(--color-fondo) 35%, transparent);
  }

  /* El fondo con foto es solo para el bloque de escritorio. */
  .frase-fondo {
    display: none;
  }

  .frase > p:first-of-type {
    max-width: 22ch;
    font-family: var(--fuente-titulos);
    font-size: var(--texto-titulo);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lema {
    color: var(--color-texto-suave);
  }

  /* Prenda destacada: solo en escritorio. */
  .retrato {
    display: none;
  }

  .marcas {
    grid-column: 1 / -1;
    padding: var(--espacio-2);
    background: var(--color-superficie);
  }

  .rotulo {
    color: var(--color-texto-suave);
    font-size: var(--texto-pequeno);
  }

  /* Móvil: una fila de tarjetas que se desliza de lado, cada una con una prenda de la marca. */
  .marcas ul {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 28vw;
    gap: var(--separacion-mosaico);
    margin: 0.75rem calc(var(--espacio-2) * -1) 0;
    padding: 0 var(--espacio-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--espacio-2);
    scrollbar-width: none;
    list-style: none;
    font-weight: 500;
  }

  .marcas li {
    scroll-snap-align: start;
  }

  .marca {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }

  .miniatura {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: calc(var(--radio) * 0.75);
    background: var(--color-fondo);
  }

  .nombre-marca {
    font-size: var(--texto-pequeno);
    line-height: 1.25;
  }

  @media (hover: hover) and (pointer: fine) {
    .miniatura .foto {
      transition: scale 600ms var(--ease-soft);
    }

    .marca:hover .miniatura .foto {
      scale: 1.08;
    }
  }

  /* Cifras en bloques de color, de claro a oscuro. */
  .cifras {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--separacion-mosaico);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cifra {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: var(--espacio-2);
    color: var(--color-sobre-acento);
  }

  .cifra:nth-child(1) {
    background: var(--color-texto);
  }

  .cifra:nth-child(2) {
    background: var(--color-arena);
  }

  .cifra:nth-child(3) {
    background: var(--color-lavanda);
  }

  .cifra:nth-child(4) {
    background: var(--color-superficie);
    color: var(--color-texto);
  }

  .valor {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-titulo);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  /* Botón principal: el bloque en salvia. */
  .accion {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 4rem;
    padding: var(--espacio-2);
    background: var(--color-salvia);
    color: var(--color-sobre-acento);
    font-family: var(--fuente-titulos);
    font-size: var(--texto-titulo);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }

  .accion:active {
    transform: scale(0.98);
  }

  .accion svg {
    transition: transform var(--t-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .accion:hover {
      background: var(--color-texto);
    }

    .accion:hover svg {
      transform: translateY(4px);
    }
  }

  /* Móvil: la marca, la foto con lo que dice XIO y el botón caben en la primera pantalla. */
  .banda {
    grid-row: 1;
  }
  .principal,
  .frase {
    grid-row: 2;
  }
  .accion {
    grid-row: 3;
  }
  .enlaces {
    grid-row: 4;
  }

  /* ---------- Escritorio: mosaico de una pantalla ---------- */
  @media (min-width: 60rem) {
    .portada {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto repeat(5, minmax(0, 1fr));
      height: 100svh;
      min-height: 40rem;
    }

    .banda {
      grid-row: 1;
    }

    .enlaces {
      grid-row: 2;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* La foto de portada es vertical: ocupa el centro, alta, para que se vea entera la escena. */
    .principal {
      grid-column: 5 / 11;
      grid-row: 3 / 8;
      aspect-ratio: auto;
    }

    /* En el mosaico la foto queda más ancha que alta: se encuadra hacia la cara y el perfume. */
    .principal .foto {
      object-position: 50% 28%;
    }

    /* Escritorio: bloque propio con una prenda de Sport de fondo, a la derecha; la sombra
       del color de la superficie deja la frase legible a la izquierda. */
    .frase {
      grid-column: 1 / 5;
      grid-row: 3 / 5;
      align-self: stretch;
      align-content: end;
      position: relative;
      isolation: isolate;
      overflow: clip;
      padding: clamp(var(--espacio-2), 2vw, var(--espacio-3));
      border-radius: var(--radio);
      background: var(--color-superficie);
    }

    /* La frase ocupa la mitad izquierda y la foto la derecha: nunca se montan. */
    .frase > p:first-of-type {
      max-width: 55%;
      font-size: clamp(1.125rem, 1.6vw, 1.75rem);
    }

    .frase-fondo {
      position: absolute;
      inset: 0 0 0 55%;
      z-index: -1;
      display: block;
    }

    .frase-fondo .foto {
      object-position: 50% 20%;
    }

    .frase-fondo::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, var(--color-superficie), transparent 30%);
    }

    .retrato {
      grid-column: 3 / 5;
      grid-row: 5 / 8;
      position: relative;
      display: block;
      overflow: clip;
      background: var(--color-superficie);
      text-decoration: none;
    }

    .retrato .foto {
      transition: transform 600ms var(--ease-soft);
    }

    .pie {
      position: absolute;
      inset: auto 0 0 0;
      padding: var(--espacio-1) 0.75rem;
      background: var(--color-fondo);
      font-size: var(--texto-pequeno);
      line-height: 1.3;
    }

    .marcas {
      grid-column: 1 / 3;
      grid-row: 5 / 8;
      align-content: end;
      display: grid;
    }

    /* Escritorio: lista vertical, cada marca con su prenda en miniatura redonda. */
    .marcas ul {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .marca {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      align-items: center;
      gap: 0.75rem;
    }

    .miniatura {
      aspect-ratio: 1;
      border-radius: 50%;
    }

    .nombre-marca {
      font-size: var(--texto-base);
    }

    .cifras {
      grid-column: 11 / 13;
      grid-row: 3 / 7;
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, minmax(0, 1fr));
    }

    .accion {
      grid-column: 11 / 13;
      grid-row: 7;
      align-items: flex-end;
      font-size: var(--texto-base);
    }
  }

  @media (min-width: 60rem) and (hover: hover) and (pointer: fine) {
    .retrato:hover .foto {
      transform: scale(1.04);
    }
  }

  /* ---------- Llegada: todo listo en 1,2 s ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .portada [data-carga] {
      opacity: 0;
      transform: translateY(1rem);
      animation: llegar 600ms var(--ease-out) forwards;
      animation-delay: var(--d, 0ms);
    }

    :global(.js) .portada [data-carga-foto] {
      clip-path: inset(0 0 100% 0 round var(--radio));
      animation: abrir 1000ms var(--ease-in-out) 150ms forwards;
    }

    :global(.js) .portada [data-carga-foto] .foto {
      scale: 1.12;
      animation: asentar 1400ms var(--ease-expo) 100ms forwards;
    }

    .banda {
      animation: aparecer 500ms ease-out both;
    }

    /* La marca sube una sola vez desde detrás de su máscara y se queda quieta. */
    .mascara > :global(*) {
      animation: emerger 900ms var(--ease-expo) 80ms both;
    }
  }

  /* Al bajar, la foto se desliza un poco dentro de su marco. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .principal .foto-marco {
        animation-name: deriva;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 40% cover 100%;
      }
    }
  }

  @keyframes llegar {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes abrir {
    to {
      clip-path: inset(0 0 0 0 round var(--radio));
    }
  }

  @keyframes asentar {
    to {
      scale: 1;
    }
  }

  @keyframes emerger {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  /* Empieza con la foto completa y se acerca un poco mientras la portada sale de pantalla. */
  @keyframes deriva {
    from {
      transform: none;
    }
    to {
      transform: scale(1.08);
    }
  }
</style>
